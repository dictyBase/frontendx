{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "react",
    "next-js",
    "oxc",
    "import",
    "js-doc",
    "jsx-a11y",
    "promise",
    "vitest",
  ],
  "categories": {
    "correctness": "error",
    "perf": "error",
    "suspicious": "error"
  },
  "rules": {
    "react-in-jsx-scope": "allow",
    "no-unassigned-import": "allow",
    "no-autofocus": "allow",
    "no-standalone-expect": "allow"
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}
