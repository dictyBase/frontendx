{
  "name": "@dictybase/generate-dependency-graph",
  "version": "0.0.0",
  "description": "script for the frontendx package",
  "main": "./src/index.ts",
  "author": "Kevin Tun",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@vitest/coverage-v8": "^0.34.5",
    "eslint-config-custom": "*",
    "tsconfig": "*",
    "typescript": "4.*",
    "vitest": "^0.33.0"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "fp-ts": "^2.16.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "lint": "TIMING=1 eslint src/ --ext .ts --ext .tsx -f unix --cache",
    "lint:out": "eslint src/ --ext .ts --ext .tsx -f json -o ../../eslint/header.json"
