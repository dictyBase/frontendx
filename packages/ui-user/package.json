{
  "name": "ui-user",
  "version": "0.0.1",
  "description": "ui components for dsc application",
  "main": "./src/index.ts",
  "author": "Siddhartha Basu",
  "license": "BSD-2-Clause",
  "dependencies": {
    "@dictybase/auth-mui5": "*"
  },
  "devDependencies": {
    "@dictybase/oxlint-config": "*",
    "@vitest/coverage-v8": "4.x",
    "eslint-config-custom": "*",
    "tsconfig": "*",
    "vitest": "4.x"
  },
  "scripts": {
    "oxlint": "oxlint src/",
    "oxlint:ci": "oxlint src/ --format=github",
    "lint": "TIMING=1 eslint src/ --ext .ts --ext .tsx -f unix --cache",
    "lint:out": "eslint src/ --ext .ts --ext .tsx -f json -o ../../eslint/ui-dsc.json"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "displayName": "ui-user",
    "readmeFile": "./README.md"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "custom"
    ]
  }
}
