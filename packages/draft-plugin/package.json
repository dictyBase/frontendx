{
  "name": "@dictybase/draft-plugin",
  "version": "0.0.0",
  "description": "Lexical editor plugin that enables automatic draft persistence in browser storage.",
  "main": "./src/index.ts",
  "author": "Kevin Tun",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@types/react": "^17.x",
    "@types/react-dom": "^17.x",
    "@testing-library/jest-dom": "^5.x",
    "@testing-library/react": "^12.x",
    "@testing-library/user-event": "^14.x",
    "vitest": "^0.33.0",
    "@vitest/coverage-v8": "^0.34.5",
    "tsconfig": "*",
    "eslint-config-custom": "*"
  },
  "dependencies": {
    "lexical": "0.11.x",
    "localforage": "1.10.*",
    "fp-ts": "^2.16.0",
    "react": "17.*"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "lint": "TIMING=1 eslint src/ --ext .ts --ext .tsx -f unix --cache",
    "lint:out": "eslint src/ --ext .ts --ext .tsx -f json -o ../../eslint/draft-plugin.json"
