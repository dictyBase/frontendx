{
  "name": "@dictybase/resizable-image",
  "version": "0.0.0",
  "description": "resizable image component for dictybase text editor",
  "main": "src/index.ts",
  "author": "Kevin Tun",
  "license": "BSD-2-Clause",
  "scripts": {
    "oxlint": "oxlint src/",
    "oxlint:ci": "oxlint src/ --format=github",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "TIMING=1 eslint src/ --ext .ts --ext .tsx -f unix --cache",
    "lint:out": "eslint src/ --ext .ts --ext .tsx -f json -o ../../eslint/resizable-image.json"
  },
  "devDependencies": {
    "@dictybase/oxlint-config": "*",
    "@types/react": "17.*",
    "@types/react-dom": "17.*",
    "@vitest/coverage-v8": "4.x",
    "eslint-config-custom": "*",
    "tsconfig": "*",
    "vitest": "4.x"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "5.*",
    "@mui/material": "5.*",
    "jotai": "^2.0.0",
    "react": "17.*"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "displayName": "@dictybase/resizable-image"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "custom"
    ]
  }
}
