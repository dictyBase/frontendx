{
  "name": "@dictybase/persistence-plugin",
  "version": "0.0.0",
  "description": "Persistence plugin for dictybase text editor",
  "main": "src/index.ts",
  "author": "Kevin Tun",
  "license": "BSD-2-Clause",
  "scripts": {
    "oxlint": "oxlint src/",
    "oxlint:ci": "oxlint src/ --format=github",
    "lint": "TIMING=1 eslint src/ --ext .ts --ext .tsx -f unix --cache",
    "lint:out": "eslint src/ --ext .ts --ext .tsx -f json -o ../../eslint/persistence-plugin.json",
    "lint:fix": "TIMING=1 eslint src/ --ext .ts --ext .tsx -f unix --cache --fix"
  },
  "devDependencies": {
    "@dictybase/oxlint-config": "*",
    "@types/react": "19.*",
    "@types/react-dom": "19.*",
    "eslint-config-custom": "*",
    "tsconfig": "*",
    "vitest": "4.x"
  },
  "dependencies": {
    "@lexical/react": "0.46.x",
    "@mui/icons-material": "5.*",
    "@mui/material": "5.*",
    "framer-motion": "^12.0.0",
    "jotai": "2.16.0",
    "lexical": "0.46.x",
    "react": "19.*",
    "react-dom": "19.*"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "displayName": "@dictybase/persistence-plugin"
  }
}
