  "description": "React component for dictybase applications",
  "main": "./src/index.ts",
  "author": "Kevin Tun",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@dictybase/oxlint-config": "*",
    "@playwright/test": "^1.44.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "17.*",
    "@types/react-dom": "17.*",
    "@vitejs/plugin-react-swc": "^4.0.1",
    "@vitest/coverage-v8": "4.x",
    "eslint-config-custom": "*",
    "tsconfig": "*",
    "vite": "7.x",
    "vitest": "4.x"
  },
  "dependencies": {
    "@dictybase/dicty-image-mui5": "*",
    "@dictybase/editor": "*",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/poppins": "^5.1.0",
    "@fontsource/roboto": "^5.0.8",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@material-ui/lab": "~4.11.3-deprecations.1",
    "@mui/icons-material": "5.*",
    "@mui/lab": "~5.0.0-alpha.175",
    "@mui/material": "5.*",
    "dicty-graphql-schema": "https://github.com/dictyBase/dicty-graphql-schema#v1.37.0",
