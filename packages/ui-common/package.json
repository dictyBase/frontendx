    "react-router-dom": "^6.14.2",
    "tss-react": "^4.9.15",
    "uuid": "9.x"
  },
  "scripts": {
    "dev": "vite",
    "oxlint": "oxlint src/",
    "oxlint:ci": "oxlint src/ --format=github",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "e2e": "BASE_URL=http://localhost:5173 playwright test",
    "lint": "TIMING=1 eslint src/ --ext .ts --ext .tsx -f unix --cache",
    "lint:out": "eslint src/ --ext .ts --ext .tsx -f json -o ../../eslint/ui-common.json"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "displayName": "ui-common",
    "readmeFile": "./README.md"
