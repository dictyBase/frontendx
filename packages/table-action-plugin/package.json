{
  "name": "@dictybase/table-action-plugin",
  "version": "0.0.0",
  "description": "Table Action plugin for dictybase text editor",
  "main": "src/index.ts",
  "author": "Kevin Tun",
  "license": "BSD-2-Clause",
  "scripts": {
    "oxlint": "oxlint src/",
    "oxlint:ci": "oxlint src/ --format=github",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "TIMING=1 eslint src/ --ext .ts --ext .tsx -f unix --cache",
    "lint:out": "eslint src/ --ext .ts --ext .tsx -f json -o ../../eslint/table-action-plugin.json"
  },
  "devDependencies": {
    "@dictybase/oxlint-config": "*",
    "@dictybase/width-table-plugin": "*",
    "@testing-library/dom": "^8.20.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "17.*",
    "@vitest/coverage-v8": "4.x",
    "eslint-config-custom": "*",
    "jsdom": "latest",
    "vitest": "4.x"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@lexical/react": "0.11.x",
    "@mui/icons-material": "5.*",
    "@mui/material": "5.*",
    "fp-ts": "^2.16.1",
    "jotai": "^2.16.0",
    "lexical": "0.11.x",
    "react": "17.*",
    "react-dom": "17.*",
    "yjs": "^13.6.7"
  }
}
