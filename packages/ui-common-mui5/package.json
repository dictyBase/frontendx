{
  "name": "@dictybase/ui-common-mui5",
  "version": "0.0.0",
  "description": "React component for dictybase applications",
  "main": "./src/index.ts",
  "author": "Kevin Tun",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@dictybase/oxlint-config": "*",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "17.*",
    "@types/react-dom": "17.*",
    "@vitest/coverage-v8": "^0.34.5",
    "eslint-config-custom": "*",
    "tsconfig": "*",
    "vitest": "0.33.*"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/poppins": "^5.1.0",
    "@fontsource/roboto": "^5.0.8",
    "@mui/material": "5.*",
    "@mui/styles": "5.*",
    "@mui/icons-material": "5.*",
    "@mui/lab": "~5.0.0-alpha.175",
    "dicty-graphql-schema": "https://github.com/dictyBase/dicty-graphql-schema#v1.31.0",
    "fp-ts": "^2.16.1",
    "react": "17.*",
    "react-dom": "17.*",
    "react-router-dom": "~6.14.2",
    "uuid": "9.x"
  },
  "scripts": {
    "oxlint": "oxlint src/",
    "oxlint:ci": "oxlint src/ --format=github",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "lint": "TIMING=1 eslint src/ --ext .ts --ext .tsx -f unix --cache",
    "lint:out": "eslint src/ --ext .ts --ext .tsx -f json -o ../../eslint/ui-common-mui5.json"
