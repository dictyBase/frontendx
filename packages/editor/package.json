{
  "name": "@dictybase/editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "oxlint": "oxlint src/",
    "oxlint:ci": "oxlint src/ --format=github",
    "lint": "eslint --ext .jsx,.js,.ts,.tsx src/",
    "lint:out": "eslint src/ --ext .ts --ext .tsx -f json -o ../../eslint/editor.json",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dictybase/editor-toolbar": "*",
    "@dictybase/persistence-plugin": "*",
    "@dictybase/table-action-plugin": "*",
    "@dictybase/width-table-plugin": "*",
    "react-router-dom": "^6.14.2",
    "tss-react": "^4.9.15"
  },
  "devDependencies": {
    "@dictybase/oxlint-config": "*",
    "@types/react": "17.*",
    "@types/react-dom": "17.*",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint-config-custom": "*",
    "tsconfig": "*",
    "vitest": "4.x"
  }
}
