{
  "name": "@dictybase/width-table-plugin",
  "version": "0.0.0",
  "description": "Table Plugin for dictybase text editor",
  "main": "src/index.ts",
  "author": "Kevin Tun",
  "license": "BSD-2-Clause",
  "scripts": {
    "oxlint": "oxlint src/",
    "oxlint:ci": "oxlint src/ --format=github",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "TIMING=1 eslint src/ --ext .ts --ext .tsx -f unix --cache",
    "lint:out": "eslint src/ --ext .ts --ext .tsx -f json -o ../../eslint/width-table-plugin.json"
  },
  "devDependencies": {
    "@dictybase/oxlint-config": "*",
    "@types/react": "17.*",
    "@vitest/coverage-v8": "4.x",
    "eslint-config-custom": "*",
    "jsdom": "latest",
    "tsconfig": "*",
    "vitest": "4.x"
  },
  "dependencies": {
    "@lexical/react": "0.11.x",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@mobily/ts-belt": "^3.13.1",
    "jotai": "^2.0.0",
    "lexical": "0.11.x",
    "react": "17.*",
    "react-dom": "17.*"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "displayName": "@dictybase/width-table-plugin"
  }
}
