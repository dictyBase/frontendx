{
  "name": "@dictybase/editor-toolbar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "oxlint": "oxlint src/",
    "oxlint:ci": "oxlint src/ --format=github",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "TIMING=1 eslint src/ --ext .ts --ext .tsx -f unix --cache",
    "lint:out": "eslint src/ --ext .ts --ext .tsx -f json -o ../../eslint/toolbar.json"
  },
  "dependencies": {
    "@dictybase/image-plugin": "*",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@hookform/resolvers": "^3.1.1",
    "@logto/react": "^2.1.2",
    "@mui/icons-material": "5.*",
    "@mui/material": "5.*",
    "dicty-graphql-schema": "https://github.com/dictyBase/dicty-graphql-schema#v1.33.0",
    "fp-ts": "^2.16.1",
    "jotai-optics": "^0.3.0",
    "optics-ts": "~2.4.1",
    "react-hook-form": "^7.45.2",
    "ts-pattern": "4.x",
    "yup": "1.2.x"
  },
  "devDependencies": {
    "@dictybase/oxlint-config": "*",
    "@lexical/headless": "^0.11.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^12.1.5",
    "eslint-config-custom": "*",
    "tsconfig": "*",
    "vitest": "4.x"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "custom"
    ]
  }
}
