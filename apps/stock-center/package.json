{
  "name": "stock-center",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite --clearScreen false",
    "dev:mock": "yarn dev --mode mock",
    "serve": "node server.js",
    "build": "tsc && vite build",
    "oxlint": "oxlint src/",
    "oxlint:ci": "oxlint src/ --format=github",
    "lint": "TIMING=1 eslint src/ --ext .ts --ext .tsx -f unix --cache",
    "lint:out": "eslint src/ --ext .ts --ext .tsx -f json -o ../../eslint/stock-center.json",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "BASE_URL=http://localhost:3003 playwright test",
    "e2e:live": "BASE_URL=https://dictybase.dev playwright test --grep-invert snapshots.spec.ts"
  },
  "dependencies": {
    "@dictybase/auth-mui5": "*",
    "@dictybase/data-access": "*",
    "@dictybase/editor": "*",
    "@dictybase/google-analytics": "*",
    "@dictybase/hook": "*",
    "@dictybase/hook-dsc": "*",
    "@dictybase/ui-dsc": "*",
    "jotai": "^2.0.0",
    "ui-user": "*"
  },
  "devDependencies": {
    "@dictybase/oxlint-config": "*",
    "@playwright/test": "^1.44.0",
    "@vitejs/plugin-react-swc": "^4.0.1",
    "eslint-config-custom": "*",
    "msw": "2.x",
    "tsconfig": "*",
    "vite": "7.x"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "custom"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
