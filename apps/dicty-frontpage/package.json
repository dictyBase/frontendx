{
  "name": "dicty-frontpage",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "e2e": "BASE_URL=http://localhost:3004 playwright test",
    "e2e:live": "BASE_URL=https://dictybase.dev playwright test --grep-invert snapshots.spec.ts",
    "coverage-report": "npx nyc@17 report --reporter=lcov",
    "dev": "vite",
    "dev:mock": "vite --host --mode mock",
    "dev:seed": "vite --host --mode seed",
    "test": "TZ=UTC vitest run",
    "build": "vite build",
    "serve": "vite preview --port 3000",
    "oxlint": "oxlint src/",
    "oxlint:ci": "oxlint src/ --format=github",
    "lint": "TIMING=1 eslint src/ --ext .ts --ext .tsx --cache",
    "lint:out": "eslint src/ --ext .ts --ext .tsx -f json -o ../../eslint/dicty-frontpage.json",
    "coverage": "yarn test --coverage",
    "styleguide": "FAST_REFRESH=false styleguidist server",
    "styleguide:build": "FAST_REFRESH=false styleguidist build",
    "analyze": "source-map-explorer 'build/static/js/*.js'"
  },
  "dependencies": {
    "@apollo/client": "3.x",
    "@dictybase/auth-mui5": "*",
    "@dictybase/data-access": "*",
    "@dictybase/editor": "*",
    "@dictybase/google-analytics": "*",
    "@dictybase/hook": "*",
    "@dictybase/ui-frontpage": "*",
    "@fontsource-variable/playfair-display": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@hookform/resolvers": "^3.1.1",
    "@mui/icons-material": "5.*",
    "@mui/material": "5.*",
    "@playwright/test": "^1.44.0",
    "apollo-upload-client": "^18.0.1",
    "apollo3-cache-persist": "^0.14.1",
    "browser-level": "^1.0.1",
    "core-js": "^3.31.1",
    "dicty-hooks": "dictybase/dicty-hooks#3.0.0",
    "font-awesome": "^4.7.0",
    "fontsource-roboto": "^4.0.0",
    "fp-ts": "^2.16.1",
    "history": "^5.3.0",
    "localforage": "1.10.*",
    "nanoid": "~5.0.3",
    "react-app-polyfill": "^3.0.0",
    "react-helmet": "^6.1.0",
    "react-loading-skeleton": "^3.3.1",
    "twitter-fetcher": "^18.0.4",
    "ui-user": "*",
    "yup": "1.2.x"
  },
  "devDependencies": {
    "@dictybase/oxlint-config": "*",
    "@testing-library/dom": "^8.20.0",
    "@testing-library/react": "^12.1.5",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^22.15.0",
    "@types/react": "17.*",
    "@types/react-dom": "17.*",
    "@types/react-fontawesome": "^1.6.8",
    "@types/react-helmet": "^6.1.6",
    "@vitejs/plugin-react-swc": "^4.0.1",
    "@vitest/coverage-v8": "4.x",
    "eslint-config-custom": "*",
    "msw": "2.x",
    "prettier": "3.*",
    "react-docgen-typescript": "^2.2.2",
    "source-map-explorer": "^2.5.3",
    "tsconfig": "*",
    "vite": "7.x",
    "vitest": "4.x",
    "vitest-fetch-mock": "^0.2.2",
    "wait-for-expect": "^3.0.2"
  },
  "resolutions": {
    "**/@types/react": "17.x",
    "**/@types/react-dom": "17.x"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ]
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "custom"
    ]
  },
  "msw": {
    "workerDirectory": "public"
  }
}
