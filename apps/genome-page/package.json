{
  "name": "genomepage",
  "version": "0.0.0",
  "private": true,
  "homepage": "/gene",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "serve": "vite preview --port 3002",
    "test": "vitest run",
    "e2e": "BASE_URL=http://localhost:3002 playwright test",
    "e2e:live": "BASE_URL=https://dictybase.dev playwright test --grep-invert snapshots.spec.ts",
    "coverage": "vitest --coverage",
    "oxlint": "oxlint src/",
    "oxlint:ci": "oxlint src/ --format=github",
    "lint": "eslint  ./ --ext .ts --ext .tsx",
    "lint:out": "eslint ./ --ext .ts --ext .tsx -f json -o ../../eslint/genomepage.json",
    "tsc": "tsc"
  },
  "dependencies": {
    "@apollo/client": "3.x",
    "@dictybase/auth-mui5": "*",
    "@dictybase/data-access": "*",
    "@dictybase/google-analytics": "*",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@isomorphic-git/lightning-fs": "~4.6.0",
    "@logto/react": "^2.1.2",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@material-ui/styles": "^4.11.5",
    "apollo3-cache-persist": "^0.14.1",
    "date-fns": "^2.30.0",
    "dicty-graphql-schema": "https://github.com/dictyBase/dicty-graphql-schema#v1.37.0",
    "element-remove": "^1.0.4",
    "font-awesome": "^4.7.0",
    "fontsource-roboto": "^4.0.0",
    "fp-ts": "^2.16.1",
    "fp-ts-std": "^0.17.1",
    "graphql": "^16.8.1",
    "isomorphic-git": "^1.25.0",
    "jotai": "2.16.0",
    "localforage": "1.10.*",
    "monocle-ts": "^2.3.13",
    "newtype-ts": "^0.3.5",
    "react": "17.*",
    "react-dom": "17.*",
    "react-fontawesome": "^1.7.1",
    "react-helmet": "^6.1.0",
    "react-markdown": "^8.0.7",
    "react-router-dom": "^6.14.2",
    "rxjs": "~7.8",
    "string.prototype.includes": "^2.0.0",
    "typescript": "4.*",
    "whatwg-fetch": "^3.6.19"
  },
  "devDependencies": {
    "@dictybase/oxlint-config": "*",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^22.15.0",
    "@types/react": "17.*",
    "@types/react-fontawesome": "^1.6.8",
    "@types/react-helmet": "^6.1.6",
    "@vitejs/plugin-react-swc": "^4.0.1",
    "@vitest/coverage-v8": "4.x",
    "husky": "8",
    "msw": "2.x",
    "prettier": "3.*",
    "react-docgen-typescript": "^2.2.2",
    "vite": "7.x",
    "vitest": "4.x"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "custom"
    ]
  }
}
